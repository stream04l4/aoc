# Environment variables for AOC (copy to .env and fill in secrets)
# Never commit .env to git.

# PostgreSQL (used by docker-compose and AOC)
POSTGRES_USER=aoc
POSTGRES_PASSWORD=aoc_change_me
POSTGRES_DB=aoc
AOC_DATABASE__URL=postgresql+asyncpg://aoc:aoc_change_me@127.0.0.1:5433/aoc

# Brain LLM (OpenAI-compatible endpoint)
AOC_LLM__BASE_URL=http://127.0.0.1:8000/v1
AOC_LLM__MODEL=Qwen/Qwen3.8-27B-FP8
AOC_LLM__API_KEY=

# Long-term memory (Letta)
AOC_MEMORY__PROVIDER=letta
AOC_MEMORY__LETTA_BASE_URL=http://127.0.0.1:8283
AOC_MEMORY__LETTA_TOKEN=

# API Authentication (required when auth_enabled=true; non-loopback bind requires a key)
AOC_API__ADMIN_KEY=
AOC_API__INTERNAL_TOKEN=

# Optional overrides
# AOC_LOGGING__LEVEL=INFO
# AOC_RUNTIME__CYCLE_INTERVAL_SECONDS=60
# AOC_GOVERNANCE__BUDGET__MAX_AGENT_TASKS_PER_DAY=20
